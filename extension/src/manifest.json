{
  "manifest_version": 3,
  "name": "Edge AI",
  "version": "1.0.0",
  "description": "Real-time translation and transcription with AI-powered features",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Edge AI"
  },
  "background": {
    "service_worker": "popup/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "88"
}